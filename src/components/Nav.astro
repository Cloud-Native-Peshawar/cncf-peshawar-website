---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { name: 'Events', href: `${base}/events` },
  { name: 'Speakers & CFP', href: `${base}/speak` },
  { name: 'Sponsors & Impact', href: `${base}/sponsors` },
  { name: 'Team', href: `${base}/team` },
  { name: 'Blog', href: `${base}/blog` },
  { name: 'Code of Conduct', href: `${base}/code-of-conduct` },
];

const currentPath = Astro.url.pathname;
---

<header class="nav-wrapper">
  <nav class="nav" aria-label="Main Navigation">
    <!-- Brand / Logo -->
    <a href={`${base}/`} class="nav__brand" aria-label="CNCF Peshawar Home">
      <div class="nav__logo-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 2L2 7V17L12 22L22 17V7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M12 22V12" stroke="currentColor" stroke-width="2"/>
          <path d="M22 7L12 12L2 7" stroke="currentColor" stroke-width="2"/>
          <circle cx="12" cy="12" r="3" fill="var(--color-accent)"/>
        </svg>
      </div>
      <div class="nav__brand-text">
        <span class="nav__brand-title">CNCF</span>
        <span class="nav__brand-subtitle">Peshawar</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <ul class="nav__menu" role="list">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== `${base}/` && currentPath.startsWith(link.href));
        return (
          <li class="nav__item">
            <a 
              href={link.href} 
              class={`nav__link ${isActive ? 'is-active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.name}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Action Group / OCG CTA -->
    <div class="nav__actions">
      <a 
        href="https://ocgroups.dev/cncf/group/6vwk2n4" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn--accent nav__cta"
      >
        <span class="nav__cta-dot"></span>
        <span>Join on OCG</span>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button 
        id="mobile-nav-toggle" 
        class="nav__toggle" 
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg class="nav__toggle-icon open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="nav__toggle-icon close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div id="mobile-nav-drawer" class="nav-drawer" aria-hidden="true" inert>
    <ul class="nav-drawer__list" role="list">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== `${base}/` && currentPath.startsWith(link.href));
        return (
          <li>
            <a 
              href={link.href} 
              class={`nav-drawer__link ${isActive ? 'is-active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.name}
            </a>
          </li>
        );
      })}
      <li class="nav-drawer__action">
        <a 
          href="https://ocgroups.dev/cncf/group/6vwk2n4" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn--accent"
        >
          Join Chapter on Open Community Groups (OCG)
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  .nav-wrapper {
    position: sticky;
    top: var(--space-xs);
    z-index: 100;
    padding-inline: clamp(var(--space-sm), 4vw, var(--space-xl));
    margin-bottom: var(--space-lg);
  }

  /* Page scroll lock while the drawer is open. Locking the root element freezes the
     document where it stands: the page behind the drawer stops scrolling without
     being repositioned, which keeps the sticky nav and its toggle on screen. A fixed
     body was the obvious alternative, but it drags the sticky nav out of the viewport
     and leaves the drawer with no visible way to close it. */
  html:has(.nav-drawer.is-open) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  /* The frozen page no longer paints its own scrollbar, so the freed width is
     returned as body padding to stop the layout shifting sideways. */
  body:has(.nav-drawer.is-open) {
    padding-right: var(--nav-scrollbar-gap, 0px);
  }

  .nav {
    max-width: var(--container-max);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    background-color: var(--color-paper-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-sm);
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    /* The brand must be allowed to give way to the toggle. Without this it keeps its
       intrinsic width when the text is enlarged, slides over the button, and the
       menu becomes impossible to open on a narrow screen. */
    min-width: 0;
    color: var(--color-ink);
  }

  .nav__logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .nav__brand-text {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    min-width: 0;
    gap: 4px;
    font-family: var(--font-brand);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-base);
    letter-spacing: -0.02em;
    /* Words break only when they cannot fit on a line of their own. `anywhere` here
       would let the wordmark shatter one character per line, which at large text
       sizes grows the header until the drawer has no room left to open. */
    overflow-wrap: break-word;
  }

  .nav__brand-title {
    color: var(--color-ink);
  }

  .nav__brand-subtitle {
    color: var(--color-accent);
  }

  .nav__menu {
    display: none;
    list-style: none;
    align-items: center;
    gap: var(--space-2xs);
  }

  @media (min-width: 860px) {
    .nav__menu {
      display: flex;
    }
  }

  .nav__link {
    display: inline-block;
    padding: 0.4rem 0.75rem;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink-muted);
    border-radius: var(--radius-full);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav__link:hover {
    color: var(--color-ink);
    background-color: var(--color-paper-subtle);
  }

  .nav__link.is-active {
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
    background-color: var(--color-accent-subtle);
    box-shadow: inset 0 -1px 0 var(--color-accent);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    /* The action group holds the only way in and out of the menu on mobile, so it
       must never be squeezed by a growing brand. */
    flex-shrink: 0;
    gap: var(--space-xs);
    margin-left: auto;
  }

  .nav__cta {
    display: none;
    font-size: var(--font-size-xs);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-glow);
  }

  @media (min-width: 860px) {
    .nav__cta {
      display: inline-flex;
    }
  }

  .nav__cta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-signal-green);
  }

  .nav__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background-color: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  @media (min-width: 860px) {
    .nav__toggle {
      display: none;
    }
  }

  .nav__toggle-icon.close {
    display: none;
  }

  .nav-drawer {
    /* Viewport-aware ceiling. The script writes --nav-drawer-max-height from the
       measured distance to the bottom of the sticky nav; the calc() values are the
       pre-script fallback, so the drawer is still bounded before hydration. */
    --drawer-max-height: calc(100vh - 7rem);
    display: none;
    position: absolute;
    top: calc(100% + var(--space-xs));
    left: clamp(var(--space-sm), 4vw, var(--space-xl));
    right: clamp(var(--space-sm), 4vw, var(--space-xl));
    max-height: var(--nav-drawer-max-height, var(--drawer-max-height));
    /* Independent scroll: a landscape phone at 390px tall has less room than the
       menu needs, so the list scrolls within the drawer instead of overflowing it. */
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    scroll-padding-block: var(--space-2xs);
    background-color: var(--color-paper-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    /* Safe-area insets are 0 on devices that do not expose them, so this adds
       spacing only where the hardware actually reserves it. */
    padding-right: calc(var(--space-md) + env(safe-area-inset-right, 0px));
    padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom, 0px));
    padding-left: calc(var(--space-md) + env(safe-area-inset-left, 0px));
    box-shadow: var(--shadow-lg);
  }

  @supports (height: 100dvh) {
    .nav-drawer {
      --drawer-max-height: calc(100dvh - 7rem);
    }
  }

  .nav-drawer.is-open {
    display: block;
  }

  .nav-wrapper:has(.nav-drawer.is-open) .nav__toggle-icon.open {
    display: none;
  }

  .nav-wrapper:has(.nav-drawer.is-open) .nav__toggle-icon.close {
    display: block;
  }

  .nav-drawer__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .nav-drawer__link {
    display: block;
    padding: 0.65rem var(--space-sm);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
    border-radius: var(--radius-sm);
    /* Long labels wrap at large text sizes rather than clipping, and the item keeps
       a 44px-tall minimum so it stays an easy target in landscape. */
    min-height: 44px;
    overflow-wrap: anywhere;
    scroll-margin-block: var(--space-2xs);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  /* Focus must stay visible on items that start below the scroll fold, including
     the focused element scrolled into view by the keyboard. */
  .nav-drawer__link:focus-visible,
  .nav-drawer__action a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
    background-color: var(--color-paper-subtle);
    color: var(--color-accent);
  }

  .nav-drawer__link:hover,
  .nav-drawer__link.is-active {
    background-color: var(--color-paper-subtle);
    color: var(--color-accent);
  }

  .nav-drawer__action {
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .nav-drawer__action .btn {
    width: 100%;
    min-height: 44px;
  }
</style>

<script>
  function setupMobileNav() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    const navWrapper = document.querySelector('.nav-wrapper');

    if (!toggleBtn || !drawer) return;

    let scrollY = 0;

    // The drawer is anchored below the sticky nav, so the space it may occupy is
    // whatever remains between the nav's bottom edge and the viewport bottom. Reading
    // that back from the layout keeps the ceiling correct across rotation, soft
    // keyboards, and increased text sizes, none of which CSS alone can measure.
    function updateMaxHeight() {
      if (!drawer) return;
      const navBottom = (navWrapper ?? drawer.parentElement)?.getBoundingClientRect().bottom ?? 0;
      const gap = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--space-xs')) || 0;
      const insetBottom = Number.parseFloat(
        getComputedStyle(drawer).getPropertyValue('padding-bottom')
      ) || 0;
      const available = window.innerHeight - navBottom - gap - insetBottom;

      drawer.style.setProperty('--nav-drawer-max-height', `${Math.max(available, 0)}px`);
    }

    function closeDrawer({ restoreFocus = false } = {}) {
      if (!toggleBtn || !drawer) return;
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.setAttribute('aria-label', 'Open navigation menu');
      drawer.setAttribute('aria-hidden', 'true');
      // `inert` keeps the closed drawer out of the tab order and away from
      // assistive technology, which aria-hidden alone does not guarantee.
      drawer.setAttribute('inert', '');
      // Reset the scroll position while the drawer is still rendered: a scrollTop
      // write on a display:none element is discarded, and the browser would then
      // restore the old offset the next time the drawer appears.
      drawer.scrollTop = 0;
      drawer.classList.remove('is-open');
      drawer.style.removeProperty('--nav-drawer-max-height');

      // The scroll lock is CSS-driven, so releasing it is a matter of dropping the
      // class and the scrollbar compensation. Some browsers reset the scroll offset
      // when the root overflow is restored, so the visitor's position is reinstated
      // on the next frame, once the relaid-out page has settled.
      document.documentElement.style.removeProperty('--nav-scrollbar-gap');
      if (scrollY) {
        // Two things fight a plain scrollTo here: the site scrolls smoothly, so a
        // restored position would visibly rewind, and handing the scrollbar back
        // reflows the page wider, which re-anchors the offset underneath us. An
        // instant jump plus a second-frame reassertion settles it.
        const restore = () => {
          if (window.scrollY !== scrollY) {
            window.scrollTo({ top: scrollY, behavior: 'instant' });
          }
        };
        requestAnimationFrame(() => {
          restore();
          requestAnimationFrame(restore);
        });
      }

      if (restoreFocus) toggleBtn.focus();
    }

    function openDrawer() {
      if (!toggleBtn || !drawer) return;
      scrollY = window.scrollY;

      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('aria-label', 'Close navigation menu');
      drawer.setAttribute('aria-hidden', 'false');
      drawer.removeAttribute('inert');
      // Freezing the root stops the page behind the drawer from scrolling, and
      // compensating for the scrollbar width stops a sideways jump on desktop.
      const scrollbarGap = window.innerWidth - document.documentElement.clientWidth;
      document.documentElement.style.setProperty('--nav-scrollbar-gap', `${Math.max(scrollbarGap, 0)}px`);

      // Clear any offset left over from a previous open before the drawer is shown.
      drawer.scrollTop = 0;
      updateMaxHeight();
      drawer.classList.add('is-open');
    }

    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (drawer.classList.contains('is-open') && !navWrapper?.contains(e.target as Node)) {
        closeDrawer();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeDrawer({ restoreFocus: true });
      }
    });

    // Re-measure when the viewport changes: rotation, a soft keyboard opening, or a
    // text-size change all alter the space the drawer may use.
    const onViewportChange = () => {
      if (drawer.classList.contains('is-open')) updateMaxHeight();
    };
    window.addEventListener('resize', onViewportChange);
    window.addEventListener('orientationchange', onViewportChange);
    window.visualViewport?.addEventListener('resize', onViewportChange);

    // Growing past the desktop breakpoint hides the toggle, so an open drawer would
    // have no way to be dismissed. Close it and hand focus back to the menu.
    const desktopQuery = window.matchMedia('(min-width: 860px)');
    const onBreakpointChange = (e: MediaQueryList | MediaQueryListEvent) => {
      if (e.matches && drawer.classList.contains('is-open')) {
        closeDrawer();
        document.querySelector<HTMLAnchorElement>('.nav__menu .nav__link')?.focus();
      }
    };
    desktopQuery.addEventListener('change', onBreakpointChange);

    // Trap focus inside the open drawer so tabbing cannot land on the inert page
    // behind it, and so the toggle is always reachable as the way back out.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !drawer.classList.contains('is-open')) return;

      const focusables = [toggleBtn, ...drawer.querySelectorAll<HTMLElement>('a, button')].filter(
        el => el.offsetParent !== null
      );
      if (focusables.length === 0) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (e.shiftKey && (document.activeElement === first || document.activeElement === toggleBtn)) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Close on drawer link click
    const drawerLinks = drawer.querySelectorAll('a');
    drawerLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeDrawer();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileNav);
  } else {
    setupMobileNav();
  }
  document.addEventListener('astro:page-load', setupMobileNav);
</script>
